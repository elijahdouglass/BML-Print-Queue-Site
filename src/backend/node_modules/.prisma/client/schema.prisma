// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  discord   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  printJobs PrintJob[]
  usage     Float      @default(0.00)

  @@map("users")
}

model PrintJob {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  partName             String
  quantity             Int       @default(1)
  color                String
  material             String
  userSuppliedMaterial Boolean   @default(false)
  specialInstructions  String?   @db.Text
  stlUrl               String    @db.Text
  pickupLocation       String?   @db.Text
  status               JobStatus @default(PENDING)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  completedAt          DateTime?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("print_jobs")
}

enum JobStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  ACTION_NEEDED
  CANCELLED
  FAILED
  WAITING
}
